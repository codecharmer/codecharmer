<?xml version="1.0"?>
<ruleset name="CodeCharmer">
	<description>Coding standards for the Code Charmer block theme and codecharmer-core plugin (WordPress + WordPress-Extra + WordPress VIP + PHP 8.3 compatibility).</description>

	<!-- What to scan. Paths are relative to this file (repo root). -->
	<file>wp-content/themes/codecharmer</file>
	<file>wp-content/plugins/codecharmer-core</file>

	<!-- Global excludes. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/assets/build/*</exclude-pattern>
	<exclude-pattern>*/assets/*.min.*</exclude-pattern>
	<exclude-pattern>*.min.css</exclude-pattern>
	<exclude-pattern>*.min.js</exclude-pattern>
	<!-- Block theme markup / editor JSON are not PHP-sniffable. -->
	<exclude-pattern>*/parts/*.html</exclude-pattern>
	<exclude-pattern>*/templates/*.html</exclude-pattern>
	<exclude-pattern>*/styles/*.json</exclude-pattern>

	<!-- Run options. -->
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/> <!-- show sniff codes + progress -->

	<config name="testVersion" value="8.3-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<!-- WordPress core + extra + docs. -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- WordPress VIP platform rules (the explicit requirement for this build). -->
	<rule ref="WordPress-VIP-Go"/>

	<!-- Forbid syntax/functions unavailable on the declared PHP floor. -->
	<rule ref="PHPCompatibilityWP"/>

	<!-- i18n: enforce the correct text domains. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="codecharmer"/>
				<element value="codecharmer-core"/>
			</property>
		</properties>
	</rule>

	<!-- Global/hook/option prefixing: allow the project prefixes. Block render
	     templates and the seed-data files execute inside callback scope (the
	     block render callback / the installer's include), so their $cc_*
	     locals are not real globals — excluded rather than renamed to the
	     full prefix, which would only add noise. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="codecharmer"/>
				<element value="CodeCharmer"/>
				<element value="CODECHARMER"/>
			</property>
		</properties>
		<exclude-pattern>wp-content/plugins/codecharmer-core/src/blocks/*/render.php</exclude-pattern>
		<exclude-pattern>wp-content/plugins/codecharmer-core/data/*</exclude-pattern>
	</rule>

	<!-- The plugin is namespaced (PSR-4 CodeCharmer\Core\), so filename rules that
	     expect class-*.php / WP hyphenated files should not fire on src/. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>wp-content/plugins/codecharmer-core/src/*</exclude-pattern>
	</rule>
</ruleset>
