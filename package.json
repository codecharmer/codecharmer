{
  "name": "codecharmer",
  "version": "1.0.0",
  "private": true,
  "description": "Code Charmer — premium digital engineering studio. WordPress block theme + core plugin monorepo. Root workspace: tooling, local dev, and block builds.",
  "author": "Code Charmer",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "workspaces": [
    "wp-content/themes/codecharmer",
    "wp-content/plugins/codecharmer-core"
  ],
  "scripts": {
    "build": "npm run build:blocks",
    "build:blocks": "npm run build --workspace=wp-content/plugins/codecharmer-core",
    "start": "npm run start --workspace=wp-content/plugins/codecharmer-core",
    "lint:js": "npm run lint:js --workspace=wp-content/plugins/codecharmer-core",
    "lint:css": "npm run lint:css --workspace=wp-content/plugins/codecharmer-core",
    "lint": "npm run lint:js && npm run lint:css",
    "env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:clean": "wp-env clean all",
    "env:cli": "wp-env run cli wp",
    "env:install-content": "wp-env run cli wp codecharmer install"
  },
  "devDependencies": {
    "@wordpress/env": "^10.0.0",
    "typescript": "~5.5.4"
  }
}
