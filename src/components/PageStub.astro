---
/**
 * Temporary on-brand placeholder for routes not yet crafted.
 * Keeps the site fully navigable (no 404s) while pages are built one at a
 * time per docs/site-plan.md. Replace each with its real page during craft.
 */
import Base from '@layouts/Base.astro';
import Button from '@components/ui/Button.astro';
import CtaBand from '@components/blocks/CtaBand.astro';
import { nav } from '@data/site';

interface Props {
  kind: string;
  title: string;
  intro: string;
  path?: string;
}
const { kind, title, intro, path } = Astro.props;
---

<Base title={`${title} — Code Charmer`} description={intro} path={path}>
  <section class="stub band-ink">
    <div class="stub__ambient" aria-hidden="true"></div>
    <div class="container stub__inner">
      <p class="eyebrow">{kind}</p>
      <h1 class="stub__title">{title}</h1>
      <p class="stub__intro">{intro}</p>
      <p class="stub__note">This page is being crafted next. The homepage shows the direction.</p>
      <div class="stub__actions">
        <Button href="/" variant="secondary">Back to home</Button>
        <Button href={nav.cta.href} variant="primary">{nav.cta.label}</Button>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .stub { position: relative; overflow: clip; padding-block: clamp(5rem, 3rem + 12vw, 10rem); }
  .stub__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(55% 55% at 70% 25%, oklch(0.79 0.12 202 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .stub__inner { position: relative; max-width: 44rem; }
  .stub__title { margin-top: 1rem; font-size: var(--t-display); letter-spacing: -0.03em; line-height: 1.03; }
  .stub__intro { margin-top: 1.25rem; font-size: var(--t-body-lg); color: var(--on-ink-mut); max-width: 36rem; text-wrap: pretty; }
  .stub__note {
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--on-ink-mut);
  }
  .stub__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
</style>
