---
/**
 * Single coherent line-icon set. 24×24, 1.5px stroke, currentColor.
 * One library, no mixing (DESIGN.md). Decorative by default (aria-hidden).
 */
import type { IconName } from '@data/site';

interface Props {
  name: IconName | 'menu' | 'close' | 'calendar';
  size?: number;
  class?: string;
}
const { name, size = 24, class: klass } = Astro.props;
---

<svg
  class={klass}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'architecture' && (
    <>
      <path d="M12 3 3 7.5 12 12l9-4.5L12 3Z" />
      <path d="M3 12l9 4.5L21 12" />
      <path d="M3 16.5 12 21l9-4.5" />
    </>
  )}
  {name === 'blocks' && (
    <>
      <rect x="3.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="13.5" y="3.5" width="7" height="7" rx="1.5" />
      <rect x="3.5" y="13.5" width="7" height="7" rx="1.5" />
      <path d="M17 13.5v7M13.5 17h7" />
    </>
  )}
  {name === 'terminal' && (
    <>
      <rect x="3" y="4.5" width="18" height="15" rx="2.5" />
      <path d="m7.5 10 3 2.5-3 2.5" />
      <path d="M13 15h4" />
    </>
  )}
  {name === 'flow' && (
    <>
      <circle cx="6" cy="6" r="2.5" />
      <circle cx="18" cy="6" r="2.5" />
      <circle cx="12" cy="18" r="2.5" />
      <path d="M8.2 7.4 10.5 16M15.8 7.4 13.5 16M8.5 6h7" />
    </>
  )}
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'spark' && (
    <path d="M12 3c.4 3.6 1.4 6.6 4.5 9-3.1 2.4-4.1 5.4-4.5 9-.4-3.6-1.4-6.6-4.5-9 3.1-2.4 4.1-5.4 4.5-9Z" />
  )}
  {name === 'check' && <path d="m4.5 12.5 4.5 4.5 10.5-11" />}
  {name === 'external' && <path d="M8 6h10v10M18 6 6.5 17.5" />}
  {name === 'calendar' && (
    <>
      <rect x="3.5" y="5" width="17" height="15.5" rx="2.5" />
      <path d="M3.5 9.5h17M8 3v4m8-4v4" />
    </>
  )}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
