---
/**
 * The hero system — three layered planes with real traffic between them.
 *
 * Brand imagery, not stock (DESIGN.md). Deliberately shares the instrumented
 * rail's vocabulary: the same tick ruler, the same measured register, mono
 * labels used for data rather than decoration. The hero and the process rails
 * should read as two views of one system.
 *
 * The node labels are the studio's actual four disciplines and the artefacts
 * they produce — the graphic says what the site says.
 */
interface Props { class?: string }
const { class: klass } = Astro.props;

const C = {
  line: 'oklch(0.83 0.13 200 / 0.34)',
  edge: 'oklch(0.83 0.13 200 / 0.22)',
  bright: 'oklch(0.83 0.13 200)',
  fillDark: 'oklch(0.19 0.025 236)',
  raised: 'oklch(0.245 0.026 236)',
  label: 'oklch(0.72 0.015 216)',
  tick: 'oklch(1 0 0 / 0.16)',
};

/** Plane bands: label, y of the band's top rule, band height. */
const planes = [
  { id: 'interface', label: 'INTERFACE', y: 44, h: 96 },
  { id: 'logic', label: 'LOGIC', y: 172, h: 118 },
  { id: 'data', label: 'DATA', y: 322, h: 100 },
];

/** Node box width — sized so the longest label ("knowledge") clears it. */
const W = 100;

/** Interface plane — what clients actually get handed. */
const surfaces = [
  { x: 90, label: 'site' },
  { x: 210, label: 'portal' },
  { x: 330, label: 'dashboard' },
];

/** Data plane — what the system stands on. */
const stores = [
  { x: 90, label: 'content' },
  { x: 210, label: 'records' },
  { x: 330, label: 'knowledge' },
];
---

<svg
  class:list={['sysdiagram', klass]}
  viewBox="6 26 482 404"
  fill="none"
  role="img"
  aria-label="A system diagram in three layers. An interface layer of site, portal and dashboard sits above a logic layer — an API, an orchestrating core, and automation — which sits above a data layer of content, records and knowledge. Signals flow between the layers."
>
  <defs>
    <radialGradient id="sd-core-glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color={C.bright} stop-opacity="0.5" />
      <stop offset="100%" stop-color={C.bright} stop-opacity="0" />
    </radialGradient>
    <linearGradient id="sd-packet" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={C.bright} stop-opacity="0" />
      <stop offset="45%" stop-color={C.bright} stop-opacity="1" />
      <stop offset="100%" stop-color={C.bright} stop-opacity="0" />
    </linearGradient>
    <clipPath id="sd-frame"><rect x="0" y="0" width="520" height="470" /></clipPath>
  </defs>

  <g clip-path="url(#sd-frame)">
    <!-- Measure: the same tick ruler the process rails are plotted against -->
    <g class="sd-ruler" aria-hidden="true">
      {Array.from({ length: 48 }, (_, i) => 42 + i * 8).map((y) => (
        <line x1="10" y1={y} x2={y % 40 === 2 ? 22 : 16} y2={y} stroke={C.tick} stroke-width="1" />
      ))}
    </g>

    <!-- Plane bands. Bracket corners, not boxes — a frame that implies
         continuation instead of enclosing a card. -->
    {planes.map((p) => (
      <g class="sd-plane">
        <path
          d={`M40 ${p.y + 12}V${p.y}H${52}M${468} ${p.y}H480V${p.y + 12}
              M40 ${p.y + p.h - 12}V${p.y + p.h}H52M468 ${p.y + p.h}H480V${p.y + p.h - 12}`}
          stroke={C.edge}
          stroke-width="1.25"
          fill="none"
        />
        <line x1="52" y1={p.y} x2="468" y2={p.y} stroke={C.edge} stroke-width="1" stroke-dasharray="2 6" />
        <text class="sd-plane-label" x="40" y={p.y - 8} fill={C.label}>{p.label}</text>
      </g>
    ))}

    <!-- Vertical channels: interface <-> logic <-> data -->
    <g stroke={C.edge} stroke-width="1.25">
      {surfaces.map((s) => <path d={`M${s.x + W / 2} 128V172`} />)}
      {stores.map((s) => <path d={`M${s.x + W / 2} 290V346`} />)}
    </g>

    <!-- Live traffic on the channels -->
    <g class="sd-flow" stroke="url(#sd-packet)" stroke-width="2.5" stroke-linecap="round">
      <path class="sd-packet" style="--d:0ms" d="M140 128V172" />
      <path class="sd-packet" style="--d:1100ms" d="M260 128V172" />
      <path class="sd-packet" style="--d:600ms" d="M380 128V172" />
      <path class="sd-packet sd-packet--up" style="--d:300ms" d="M140 290V346" />
      <path class="sd-packet sd-packet--up" style="--d:1500ms" d="M260 290V346" />
      <path class="sd-packet sd-packet--up" style="--d:900ms" d="M380 290V346" />
    </g>

    <!-- Interface plane -->
    <g class="sd-nodes">
      {surfaces.map((s, i) => (
        <g class="sd-node" style={`--d:${120 + i * 90}ms`}>
          <rect x={s.x} y="72" width={W} height="56" rx="8" fill={C.raised} stroke={C.line} stroke-width="1.25" />
          <path d={`M${s.x + 12} 90H${s.x + 50}M${s.x + 12} 100H${s.x + 70}`} stroke={C.line} stroke-width="1.5" stroke-linecap="round" />
          <text class="sd-node-label" x={s.x + 12} y="119" fill={C.label}>{s.label}</text>
        </g>
      ))}
    </g>

    <!-- Logic plane: api — core — automation -->
    <g class="sd-nodes">
      <g class="sd-node" style="--d:420ms">
        <rect x="46" y="204" width={W} height="54" rx="8" fill={C.raised} stroke={C.line} stroke-width="1.25" />
        <text class="sd-node-label" x="60" y="226" fill={C.label}>api</text>
        <path d="M60 238h72" stroke={C.line} stroke-width="1.5" stroke-linecap="round" />
      </g>
      <g class="sd-node" style="--d:620ms">
        <rect x="374" y="204" width={W} height="54" rx="8" fill={C.raised} stroke={C.line} stroke-width="1.25" />
        <text class="sd-node-label" x="388" y="226" fill={C.label}>automation</text>
        <path d="M388 238h72" stroke={C.line} stroke-width="1.5" stroke-linecap="round" />
      </g>

      <!-- lateral links into the core -->
      <g stroke={C.edge} stroke-width="1.25">
        <path d="M146 231H212" />
        <path d="M308 231H374" />
      </g>
      <path class="sd-lateral" d="M146 231H212" stroke="url(#sd-packet)" stroke-width="2.5" stroke-linecap="round" />
      <path class="sd-lateral" style="--d:1400ms" d="M308 231H374" stroke="url(#sd-packet)" stroke-width="2.5" stroke-linecap="round" />

      <!-- core -->
      <circle class="sd-core-glow" cx="260" cy="231" r="62" fill="url(#sd-core-glow)" />
      <g class="sd-core">
        <rect x="212" y="203" width="96" height="56" rx="10" fill={C.fillDark} stroke={C.bright} stroke-width="1.5" />
        <text class="sd-core-label" x="260" y="227" fill="oklch(0.95 0.02 200)" text-anchor="middle">core</text>
        <!-- throughput meter: the same measured register as the rails -->
        <g class="sd-meter">
          {Array.from({ length: 9 }, (_, i) => (
            <rect class="sd-bar" style={`--i:${i}`} x={224 + i * 8} y="236" width="4" height="10" rx="1" fill={C.bright} />
          ))}
        </g>
      </g>
    </g>

    <!-- Data plane -->
    <g class="sd-nodes">
      {stores.map((s, i) => (
        <g class="sd-node" style={`--d:${760 + i * 90}ms`}>
          <rect x={s.x} y="346" width={W} height="52" rx="8" fill={C.raised} stroke={C.line} stroke-width="1.25" />
          <path
            d={`M${s.x + 12} 362h76M${s.x + 12} 372h76`}
            stroke={C.line}
            stroke-width="1"
            stroke-dasharray="3 4"
          />
          <text class="sd-node-label" x={s.x + 12} y="390" fill={C.label}>{s.label}</text>
        </g>
      ))}
    </g>
  </g>
</svg>

<style>
  .sysdiagram { width: 100%; height: auto; overflow: visible; }

  .sd-plane-label {
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.14em;
  }
  .sd-node-label {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.01em;
  }
  .sd-core-label {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  /* Static default: a complete, legible system. Motion only adds life. */
  .sd-packet,
  .sd-lateral { opacity: 0; }
  .sd-bar { opacity: 0.28; }

  @media (prefers-reduced-motion: no-preference) {
    .sd-core-glow {
      transform-origin: 260px 231px;
      animation: sd-pulse 5s var(--ease-out-quart) infinite;
    }
    @keyframes sd-pulse {
      0%, 100% { opacity: 0.5; transform: scale(0.94); }
      50% { opacity: 1; transform: scale(1.05); }
    }

    /* Packets travel the channels: interface down into logic, data up into it. */
    .sd-packet {
      opacity: 1;
      stroke-dasharray: 16 60;
      animation: sd-send 2.6s linear infinite;
      animation-delay: var(--d, 0ms);
    }
    @keyframes sd-send {
      from { stroke-dashoffset: 60; }
      to { stroke-dashoffset: -46; }
    }
    .sd-packet--up { animation-name: sd-send-up; }
    @keyframes sd-send-up {
      from { stroke-dashoffset: -46; }
      to { stroke-dashoffset: 60; }
    }

    .sd-lateral {
      opacity: 1;
      stroke-dasharray: 14 80;
      animation: sd-lateral-move 3.2s linear infinite;
      animation-delay: var(--d, 0ms);
    }
    @keyframes sd-lateral-move {
      from { stroke-dashoffset: 80; }
      to { stroke-dashoffset: -60; }
    }

    /* Throughput: the core is visibly doing work, not just glowing. */
    .sd-bar {
      animation: sd-work 1.9s var(--ease-out-quart) infinite;
      animation-delay: calc(var(--i) * 90ms);
      transform-box: fill-box;
      transform-origin: center bottom;
    }
    @keyframes sd-work {
      0%, 100% { opacity: 0.22; transform: scaleY(0.45); }
      45% { opacity: 1; transform: scaleY(1); }
    }

    .sd-node {
      animation: sd-arrive 0.7s var(--ease-out-expo) both;
      animation-delay: var(--d, 0ms);
      transform-box: fill-box;
      transform-origin: center;
    }
    @keyframes sd-arrive {
      from { opacity: 0; transform: translateY(10px) scale(0.94); }
      to { opacity: 1; transform: none; }
    }
  }
</style>
