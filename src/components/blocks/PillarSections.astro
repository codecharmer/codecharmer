---
import Icon from '@components/ui/Icon.astro';
import { pillars } from '@data/site';
---

<section class="section pillar-sections">
  <div class="container">
    <div class="pillar-sections__list">
      {
        pillars.map((p, i) => (
          <article class="psplit reveal" data-flip={i % 2 === 1 ? '' : undefined}>
            <div class="psplit__text">
              <p class="psplit__kicker">{`0${i + 1}`}</p>
              <h2 class="psplit__name">{p.name}</h2>
              <p class="psplit__thesis">{p.thesis}</p>
              <a class="psplit__link" href={p.href}>
                Explore {p.name.split(' ')[0]} <Icon name="arrow" size={18} />
              </a>
            </div>

            <div class="psplit__panel" aria-hidden="true">
              <div class="psplit__grid"></div>
              <span class="psplit__icon"><Icon name={p.icon} size={30} /></span>
              <ul role="list" class="psplit__caps">
                {p.included.slice(0, 3).map((cap) => (
                  <li><Icon name="check" size={14} /> {cap}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pillar-sections__list { display: grid; gap: clamp(2.5rem, 6vw, 5rem); }

  .psplit {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }
  .psplit__kicker { font-family: var(--font-mono); font-size: var(--t-small); color: var(--brand-ink); }
  .psplit__name { margin-top: 0.75rem; font-size: var(--t-h2); letter-spacing: -0.02em; }
  .psplit__thesis { margin-top: 1rem; font-size: var(--t-body-lg); color: var(--ink-muted); line-height: 1.5; max-width: 42ch; }
  .psplit__link {
    display: inline-flex; align-items: center; gap: 0.5rem;
    margin-top: 1.5rem; font-weight: 600; color: var(--brand-ink);
    transition: gap var(--dur) var(--ease-out-expo);
  }
  .psplit__link:hover { gap: 0.75rem; }

  .psplit__panel {
    position: relative;
    overflow: clip;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    min-height: 15rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--brand) 6%, var(--surface));
  }
  .psplit__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(oklch(0.48 0.1 216 / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, oklch(0.48 0.1 216 / 0.06) 1px, transparent 1px);
    background-size: 2.25rem 2.25rem;
    mask-image: radial-gradient(120% 100% at 100% 0, #000, transparent 70%);
  }
  .psplit__icon {
    position: relative;
    display: grid; place-items: center;
    width: 3.5rem; height: 3.5rem;
    border-radius: var(--radius);
    background: var(--brand);
    color: var(--on-brand);
    box-shadow: 0 8px 24px -8px oklch(0.79 0.12 202 / 0.5);
  }
  .psplit__caps { position: relative; display: flex; flex-direction: column; gap: 0.5rem; }
  .psplit__caps li {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.9rem; font-weight: 500; color: var(--ink);
  }
  .psplit__caps :global(svg) { color: var(--brand-ink); flex: none; }

  @media (min-width: 52rem) {
    .psplit { grid-template-columns: 1fr 1fr; }
    .psplit[data-flip] .psplit__text { order: 2; }
  }
</style>
