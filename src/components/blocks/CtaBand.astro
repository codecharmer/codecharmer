---
import Button from '@components/ui/Button.astro';
import { nav, site } from '@data/site';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Tell us what you’re trying to build.',
  body = 'A short conversation is usually enough to know whether we’re the right team. No pitch deck, no obligation.',
} = Astro.props;
---

<section class="cta band-ink">
  <div class="cta__glow" aria-hidden="true"></div>
  <div class="container cta__inner reveal">
    <h2 class="cta__heading">{heading}</h2>
    <p class="cta__body">{body}</p>
    <div class="cta__actions">
      <Button href={nav.cta.href} variant="primary" size="lg">{nav.cta.label}</Button>
      <Button href={`mailto:${site.email}`} variant="secondary" size="lg">Email us</Button>
    </div>
  </div>
</section>

<style>
  .cta { position: relative; overflow: clip; padding-block: clamp(4rem, 2.5rem + 8vw, 8rem); }
  .cta__glow {
    position: absolute;
    left: 50%;
    top: 62%;
    width: min(60rem, 120%);
    aspect-ratio: 2 / 1;
    translate: -50% -50%;
    background: radial-gradient(ellipse at center, oklch(0.79 0.12 202 / 0.28), transparent 62%);
    filter: blur(20px);
    pointer-events: none;
  }
  .cta__inner { position: relative; text-align: center; max-width: 40rem; margin-inline: auto; }
  .cta__heading {
    font-size: var(--t-h1);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .cta__body {
    margin-top: 1.1rem;
    font-size: var(--t-body-lg);
    color: var(--on-ink-mut);
    text-wrap: pretty;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
