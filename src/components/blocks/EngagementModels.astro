---
import { engagementModels } from '@data/site';
---

<section class="section engage">
  <div class="container">
    <header class="engage__head reveal">
      <p class="eyebrow">How we work together</p>
      <h2 class="engage__title">Engagements that fit the problem.</h2>
      <p class="lead engage__intro">
        No fixed price list — the right shape depends on how clear the work is. We’ll recommend one honestly.
      </p>
    </header>

    <ul role="list" class="engage__grid">
      {engagementModels.map((m, i) => (
        <li class="engage__card reveal" style={`--reveal-delay:${i * 80}ms`}>
          <p class="engage__best">{m.bestFor}</p>
          <h3 class="engage__name">{m.name}</h3>
          <p class="engage__body">{m.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .engage__head { max-width: 42rem; }
  .engage__title { margin-top: 0.9rem; }
  .engage__intro { margin-top: 1rem; }

  .engage__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
    margin-top: clamp(2.25rem, 4vw, 3.25rem);
  }
  .engage__card {
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color var(--dur) var(--ease-out-quart), box-shadow var(--dur) var(--ease-out-quart);
  }
  .engage__card:hover { border-color: var(--border-strong); box-shadow: var(--shadow); }
  .engage__best {
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--brand-ink);
    letter-spacing: 0.01em;
  }
  .engage__name {
    margin-top: 0.6rem;
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  .engage__body { margin-top: 0.75rem; color: var(--ink-muted); line-height: 1.55; }
</style>
