---
import Button from '@components/ui/Button.astro';
import { process } from '@data/site';

interface Props { tone?: 'light' | 'ink' }
const { tone = 'light' } = Astro.props;

/**
 * Instrumented rail geometry.
 *
 * Segment width = stage weight (decision leverage — see Stage['weight']).
 * Each stage's span along the rail is emitted as data-from/data-to fractions;
 * rail.ts compares the scroll progress against them to set node and readout
 * state. Computed here because the weights are known at build time.
 */
const total = process.reduce((sum, s) => sum + s.weight, 0);

let cursor = 0;
const stages = process.map((s) => {
  const from = cursor / total;
  cursor += s.weight;
  return { ...s, from: +from.toFixed(4), to: +(cursor / total).toFixed(4) };
});
---

<section class:list={['section process-teaser', tone === 'ink' && 'band-ink']}>
  <div class="container">
    <header class="pt__head reveal">
      <div>
        <p class="eyebrow">How we work</p>
        <h2 class="pt__title">A process that compounds.</h2>
      </div>
      <p class="lead pt__intro">
        Seven stages, each one making the next cheaper. Architecture before code, ownership before launch.
      </p>
    </header>

    <div class="pt__rail rail reveal" data-scrub="band">
      <div class="pt__ruler rail__ruler" aria-hidden="true"></div>

      <div class="pt__track rail__track" aria-hidden="true">
        {stages.map((s) => (
          <div class="rail__segment" style={`--w:${s.weight}`} data-from={s.from} data-to={s.to}>
            <i class="rail__run"></i>
            <span class="rail__node rail__node--astride" data-from={s.from} data-to={s.to} />
          </div>
        ))}
        <span class="rail__playhead"></span>
      </div>

      <ol role="list" class="pt__stages">
        {stages.map((s) => (
          <li class="pt__stage" style={`--w:${s.weight}`} data-from={s.from} data-to={s.to}>
            <span class="rail__coord">{String(s.n).padStart(2, '0')}</span>
            <span class="rail__label pt__name">{s.name}</span>
            <span class="rail__status pt__stage-status" aria-hidden="true"></span>
          </li>
        ))}
      </ol>

      <ul role="list" class="pt__readout">
        {stages.map((s) => (
          <li class="pt__out" data-from={s.from} data-to={s.to}>
            <span class="pt__out-label">{String(s.n).padStart(2, '0')} {s.name}</span>
            <span class="pt__out-text" data-type>{s.deliverable}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="pt__cta reveal">
      <Button href="/process" variant="ghost">See the full process</Button>
    </div>
  </div>
</section>

<style>
  .pt__head {
    display: grid;
    gap: 1rem 3rem;
    align-items: end;
  }
  .pt__title { margin-top: 0.9rem; }
  .pt__intro { max-width: 34rem; }

  .pt__rail {
    /* Flagship rail: chunkier than the shared default so the build run has
       room to read — the stripes need material to sweep through. */
    --rail-track-w: 7px;
    --rail-node: 13px;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }
  /* Fine ticks and boundary ticks share a baseline 4px above the track, so
     the boundary marks read as the taller ones on a single ruler. */
  .pt__ruler { margin-bottom: 4px; }

  .pt__stages {
    display: flex;
    margin-top: 1.2rem;
  }
  .pt__stage {
    flex: var(--w, 1) 1 0;
    padding-inline-end: 0.75rem;
    min-width: 0;
  }
  .pt__name {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 0.85rem + 0.5vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    /* Seven columns of varying width: let the short names hold one line and
       the long ones wrap rather than overflow their segment. */
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .pt__stage-status { margin-top: 0.45rem; }

  /* The build lights stages as it reaches them: queued recedes, running
     leads. Default (no driver) keeps everything at full strength. */
  .rail[data-rail-live] .pt__stage {
    transition: opacity var(--dur-slow) var(--ease-out-quart);
  }
  .rail[data-rail-live] .pt__stage[data-state='queued'] { opacity: 0.42; }
  .rail[data-rail-live] .pt__stage[data-state='active'] .pt__name { color: var(--brand-ink); }

  /* --- Deliverable console ------------------------------------------------
     A code well (per DESIGN.md: --surface-sunk, mono) that reads as the
     build's log output. Base: the full log, every stage ✓-prefixed with its
     deliverable — a finished run. Enhanced (scroll-driven): a single live
     line that tracks the playhead, typing out as each stage executes.
     Identical content in both modes. */
  .pt__readout {
    margin-top: clamp(1.75rem, 3vw, 2.25rem);
    padding: 1rem 1.2rem;
    background: var(--surface-sunk);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    display: grid;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    line-height: 1.55;
  }
  .pt__out { display: block; }
  .pt__out-label {
    color: var(--logo-accent);
    text-transform: lowercase;
    white-space: nowrap;
  }
  .pt__out-label::before { content: '✓ '; }
  .pt__out-label::after { content: ' › '; color: var(--ink-faint); }
  .pt__out-text { color: var(--ink-muted); }

  .rail[data-rail-live] .pt__out[data-state='queued'] .pt__out-label::before { content: '· '; }
  .rail[data-rail-live] .pt__out[data-state='active'] .pt__out-label::before { content: '▸ '; }
  /* Block caret while the line is being written. */
  .rail[data-rail-live] .pt__out[data-state='active'] .pt__out-text::after {
    content: '';
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    margin-left: 0.2ch;
    vertical-align: -0.12em;
    background: var(--brand-ink);
    animation: caret-blink 1.1s step-end infinite;
  }
  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .pt__cta { margin-top: clamp(2rem, 4vw, 2.75rem); }

  @media (min-width: 48rem) {
    .pt__head { grid-template-columns: 1fr 1fr; }
  }

  /* --- Vertical below the 7-column breakpoint ---------------------------- */
  @media (max-width: 60rem) {
    .pt__rail {
      display: grid;
      grid-template-columns: auto auto 1fr;
      gap: 0 1rem;
    }
    .pt__ruler {
      width: var(--rail-tick-len-major);
      height: auto;
      margin-bottom: 0;
      background-image:
        repeating-linear-gradient(to bottom, var(--rail-tick-major) 0 1px, transparent 1px calc(var(--rail-tick-gap) * 5)),
        repeating-linear-gradient(to bottom, var(--rail-tick) 0 1px, transparent 1px var(--rail-tick-gap));
      background-repeat: repeat-y;
      background-size:
        var(--rail-tick-len-major) calc(var(--rail-tick-gap) * 5),
        var(--rail-tick-len) var(--rail-tick-gap);
      mask-image: linear-gradient(to bottom, #000 90%, transparent);
    }
    .pt__track {
      flex-direction: column;
      width: var(--rail-track-w);
      height: auto;
      container-type: size;
    }
    .pt__track::after {
      transform-origin: center top;
      transform: scaleY(var(--rail-progress));
      background: linear-gradient(to bottom, color-mix(in oklab, var(--rail-fill) 55%, transparent), var(--rail-fill));
    }
    .pt__track .rail__segment + .rail__segment::before {
      inset-block: auto;
      inset-inline: -1px;
      top: 0;
      left: auto;
      width: auto;
      height: 2px;
    }
    .pt__track .rail__node--astride { left: 50%; top: 0; }
    .pt__track .rail__playhead {
      inset-block: auto;
      inset-inline: -4px;
      top: 0;
      left: auto;
      width: auto;
      height: 2px;
      translate: 0 calc(var(--rail-progress) * var(--rail-span, 100cqh));
    }
    .pt__track .rail__playhead::before,
    .pt__track .rail__playhead::after {
      top: -2px; left: auto; width: 2px; height: 6px;
    }
    .pt__track .rail__playhead::before { left: 0; }
    .pt__track .rail__playhead::after { right: 0; }

    .pt__stages {
      flex-direction: column;
      margin-top: 0;
    }
    .pt__stage {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      padding-inline-end: 0;
      /* Row height carries the weight in this orientation, so the segments
         beside it stay in register with their labels. */
      flex: var(--w, 1) 1 0;
      min-height: 2.75rem;
    }
    .pt__name { margin-top: 0; }

    .pt__readout { grid-column: 1 / -1; }
  }

  @media (max-width: 30rem) {
    .pt__stage { flex-direction: column; gap: 0.15rem; justify-content: center; }
  }

  /* --- Scroll-coupled readout --------------------------------------------
     Only once rail.ts marks the rail live. Until then (and forever without
     JS or with reduced motion) the block above stands: a plain list of what
     every stage delivers. Same content either way — the enhancement changes
     the presentation, never the information. */
  .rail[data-rail-live] .pt__readout {
    display: grid;
    grid-template-areas: 'readout';
    gap: 0;
    /* Reserve two log lines so typing and swapping never shift the layout. */
    min-height: calc(2 * 1.55em + 2rem);
  }
  /* Console semantics: lines replace, they don't crossfade. The outgoing
     line snaps away (no transition); the incoming one rises in while the
     typewriter writes it. */
  .rail[data-rail-live] .pt__out {
    grid-area: readout;
    opacity: 0;
    translate: 0 5px;
    transition: none;
  }
  .rail[data-rail-live] .pt__out[data-state='active'] {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--dur) var(--ease-out-quart),
      translate var(--dur) var(--ease-out-quart);
  }
  /* At progress 1 the final segment reads committed, not active — pin its
     readout rather than leaving the slot empty. */
  .rail[data-rail-live] .pt__out[data-state='committed']:last-child {
    opacity: 1;
    translate: 0 0;
    transition: opacity var(--dur) var(--ease-out-quart);
  }

  @media (prefers-reduced-motion: reduce) {
    .rail .pt__out { transition: none; }
  }
</style>
