---
import { partners, collaborators } from '@data/site';
---

<section class="section partners">
  <div class="container">
    <div class="partners__group reveal">
      <p class="partners__label eyebrow">Platform partners</p>
      <ul role="list" class="partners__cloud">
        {partners.map((name) => <li class="partners__name">{name}</li>)}
      </ul>
    </div>

    <div class="partners__group reveal">
      <p class="partners__label eyebrow">Collaborated with</p>
      <ul role="list" class="partners__cloud">
        {collaborators.map((name) => <li class="partners__name">{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .partners {
    background: var(--surface-sunk);
    border-block: 1px solid var(--border);
  }
  .partners .container { display: grid; gap: clamp(2rem, 5vw, 3.5rem); }
  .partners__label { margin-bottom: 1.25rem; }
  .partners__cloud {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(1.5rem, 5vw, 3.5rem);
  }
  .partners__name {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1rem + 1.4vw, 1.9rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
    opacity: 0.55;
    transition: opacity var(--dur) var(--ease-out-quart);
  }
  .partners__cloud:hover .partners__name { opacity: 0.35; }
  .partners__cloud .partners__name:hover { opacity: 1; }

  @media (min-width: 60rem) {
    .partners .container { grid-template-columns: 1fr 1fr; gap: 4rem; }
  }
</style>
