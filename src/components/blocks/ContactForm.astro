---
import Icon from '@components/ui/Icon.astro';
import { projectTypes, budgetRanges, timelines, contact, site } from '@data/site';
---

<form class="cform" data-contact-form data-endpoint={contact.endpoint} novalidate>
  <!-- honeypot: hidden from users, catches bots -->
  <div class="cform__hp" aria-hidden="true">
    <label for="cf-website">Website</label>
    <input type="text" id="cf-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div class="cform__grid">
    <div class="field">
      <label for="cf-name">Name <span class="req" aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby="err-name" />
      <span class="field__err" id="err-name" data-err></span>
    </div>
    <div class="field">
      <label for="cf-company">Company <span class="opt">optional</span></label>
      <input id="cf-company" name="company" type="text" autocomplete="organization" />
    </div>
  </div>

  <div class="field">
    <label for="cf-email">Email <span class="req" aria-hidden="true">*</span></label>
    <input id="cf-email" name="email" type="email" autocomplete="email" required aria-describedby="err-email" />
    <span class="field__err" id="err-email" data-err></span>
  </div>

  <div class="cform__grid">
    <div class="field">
      <label for="cf-type">Project type <span class="req" aria-hidden="true">*</span></label>
      <div class="select">
        <select id="cf-type" name="projectType" required aria-describedby="err-type">
          <option value="" disabled selected>Select one…</option>
          {projectTypes.map((t) => <option value={t}>{t}</option>)}
        </select>
        <Icon name="arrow" size={16} class="select__chev" />
      </div>
      <span class="field__err" id="err-type" data-err></span>
    </div>
    <div class="field">
      <label for="cf-budget">Budget <span class="opt">optional</span></label>
      <div class="select">
        <select id="cf-budget" name="budget">
          <option value="" disabled selected>Select a range…</option>
          {budgetRanges.map((b) => <option value={b}>{b}</option>)}
        </select>
        <Icon name="arrow" size={16} class="select__chev" />
      </div>
    </div>
  </div>

  <div class="field">
    <label for="cf-timeline">Timeline <span class="opt">optional</span></label>
    <div class="select">
      <select id="cf-timeline" name="timeline">
        <option value="" disabled selected>When do you want to start?</option>
        {timelines.map((t) => <option value={t}>{t}</option>)}
      </select>
      <Icon name="arrow" size={16} class="select__chev" />
    </div>
  </div>

  <div class="field">
    <label for="cf-message">What are you trying to build? <span class="req" aria-hidden="true">*</span></label>
    <textarea id="cf-message" name="message" rows="5" required aria-describedby="err-message"
      placeholder="A sentence or two about the problem, the goal, and anything we should know."></textarea>
    <span class="field__err" id="err-message" data-err></span>
  </div>

  <div class="cform__foot">
    <button type="submit" class="cform__submit" data-submit>
      <span data-submit-label>Send inquiry</span>
    </button>
    <p class="cform__note" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<!-- Success panel (revealed after submit) -->
<div class="cform-done" data-done hidden tabindex="-1">
  <span class="cform-done__mark" aria-hidden="true"><Icon name="check" size={26} /></span>
  <h3 class="cform-done__title">Thanks — that’s everything we need.</h3>
  <p class="cform-done__body" data-done-body>
    We’ll get back to you {contact.responseTime}. In the meantime, feel free to reply to the email with anything you forgot.
  </p>
</div>

<style>
  .cform { display: flex; flex-direction: column; gap: 1.25rem; }
  .cform__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .cform__grid { display: grid; gap: 1.25rem; }
  @media (min-width: 34rem) { .cform__grid { grid-template-columns: 1fr 1fr; } }

  .field { display: flex; flex-direction: column; gap: 0.45rem; }
  .field label { font-size: 0.9rem; font-weight: 550; color: var(--ink); }
  .req { color: var(--brand-ink); }
  .opt { font-weight: 400; color: var(--ink-faint); font-size: 0.8rem; }

  .field input,
  .field textarea,
  .select select {
    width: 100%;
    font-family: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--surface);
    border: 1.5px solid var(--border-strong);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    transition: border-color var(--dur-fast) var(--ease-out-quart), box-shadow var(--dur-fast) var(--ease-out-quart);
  }
  .field textarea { resize: vertical; min-height: 7rem; }
  .field input::placeholder,
  .field textarea::placeholder { color: var(--ink-faint); }

  .field input:focus-visible,
  .field textarea:focus-visible,
  .select select:focus-visible {
    outline: none;
    border-color: var(--brand-ink);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 30%, transparent);
  }

  /* Select with custom chevron */
  .select { position: relative; }
  .select select { appearance: none; padding-right: 2.5rem; cursor: pointer; }
  .select :global(.select__chev) {
    position: absolute;
    right: 0.85rem;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    color: var(--ink-muted);
    pointer-events: none;
  }

  /* Error state */
  .field[data-invalid] input,
  .field[data-invalid] textarea,
  .field[data-invalid] .select select { border-color: var(--danger); }
  .field__err { font-size: 0.82rem; color: var(--danger); min-height: 0; }
  .field__err:empty { display: none; }

  .cform__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 0.25rem; }
  .cform__submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1rem;
    color: var(--on-brand);
    background: var(--brand);
    border-radius: var(--radius-pill);
    padding: 0.85rem 1.75rem;
    box-shadow: 0 1px 2px oklch(0.2 0.02 236 / 0.15);
    transition: transform var(--dur-fast) var(--ease-out-quart), background-color var(--dur) var(--ease-out-quart), box-shadow var(--dur) var(--ease-out-quart);
  }
  .cform__submit:hover:not(:disabled) {
    background: var(--brand-glow);
    transform: translateY(-2px);
    box-shadow: 0 10px 26px -8px oklch(0.79 0.12 202 / 0.5);
  }
  .cform__submit:disabled { opacity: 0.65; cursor: progress; }
  .cform__note { font-size: 0.88rem; color: var(--ink-muted); }
  .cform__note[data-tone='error'] { color: var(--danger); }

  .cform-done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--brand) 7%, var(--surface));
  }
  .cform-done[hidden] { display: none; }
  .cform-done__mark {
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    border-radius: var(--radius-pill);
    background: var(--brand);
    color: var(--on-brand);
  }
  .cform-done__title { font-size: 1.4rem; letter-spacing: -0.02em; }
  .cform-done__body { color: var(--ink-muted); line-height: 1.55; }
  .cform-done:focus-visible { outline: 2px solid var(--brand-ink); outline-offset: 3px; }
</style>

<script define:vars={{ toEmail: site.email }}>
  const form = document.querySelector('[data-contact-form]');
  if (form) {
    const endpoint = form.getAttribute('data-endpoint') || '';
    const statusEl = form.querySelector('[data-status]');
    const submitBtn = form.querySelector('[data-submit]');
    const submitLabel = form.querySelector('[data-submit-label]');
    const donePanel = document.querySelector('[data-done]');
    const doneBody = document.querySelector('[data-done-body]');

    const setError = (name, msg) => {
      const field = form.querySelector(`#cf-${name}`)?.closest('.field');
      const errEl = form.querySelector(`#err-${name}`);
      if (!field || !errEl) return;
      if (msg) {
        field.setAttribute('data-invalid', '');
        form.querySelector(`#cf-${name}`)?.setAttribute('aria-invalid', 'true');
        errEl.textContent = msg;
      } else {
        field.removeAttribute('data-invalid');
        form.querySelector(`#cf-${name}`)?.removeAttribute('aria-invalid');
        errEl.textContent = '';
      }
    };

    const validate = (data) => {
      const errors = {};
      if (!data.name?.trim()) errors.name = 'Please add your name.';
      if (!data.email?.trim()) errors.email = 'We need an email to reply to.';
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) errors.email = 'That email doesn’t look right.';
      if (!data.projectType) errors.type = 'Pick the closest match.';
      if (!data.message?.trim() || data.message.trim().length < 10) errors.message = 'A sentence or two helps us reply well.';
      return errors;
    };

    const buildMailto = (data) => {
      const subject = `Project inquiry — ${data.name}`;
      const lines = [
        `Name: ${data.name}`,
        `Company: ${data.company || '—'}`,
        `Email: ${data.email}`,
        `Project type: ${data.projectType}`,
        `Budget: ${data.budget || '—'}`,
        `Timeline: ${data.timeline || '—'}`,
        '',
        data.message,
      ];
      return `mailto:${toEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    };

    const finish = (viaEmailClient) => {
      form.hidden = true;
      if (viaEmailClient && doneBody) {
        doneBody.textContent =
          'We’ve opened your email client with the details filled in — hit send and we’ll take it from there.';
      }
      if (donePanel) { donePanel.hidden = false; donePanel.focus(); }
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      // honeypot
      if (fd.get('website')) { finish(false); return; }

      const data = Object.fromEntries(fd.entries());
      ['name', 'email', 'type', 'message'].forEach((n) => setError(n, ''));
      const errors = validate(data);
      if (Object.keys(errors).length) {
        Object.entries(errors).forEach(([k, v]) => setError(k, v));
        const firstKey = Object.keys(errors)[0];
        const firstId = firstKey === 'type' ? 'cf-type' : `cf-${firstKey}`;
        form.querySelector(`#${firstId}`)?.focus();
        if (statusEl) { statusEl.textContent = 'Please fix the highlighted fields.'; statusEl.setAttribute('data-tone', 'error'); }
        return;
      }

      submitBtn?.setAttribute('disabled', '');
      if (submitLabel) submitLabel.textContent = 'Sending…';
      if (statusEl) { statusEl.textContent = ''; statusEl.removeAttribute('data-tone'); }

      try {
        if (endpoint) {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify(data),
          });
          if (!res.ok) throw new Error('bad status');
          finish(false);
        } else {
          // No backend configured yet — open a prefilled email so it works today.
          window.location.href = buildMailto(data);
          finish(true);
        }
      } catch (err) {
        submitBtn?.removeAttribute('disabled');
        if (submitLabel) submitLabel.textContent = 'Send inquiry';
        if (statusEl) {
          statusEl.textContent = `Something went wrong. Email us directly at ${toEmail}.`;
          statusEl.setAttribute('data-tone', 'error');
        }
      }
    });

    // Clear a field's error as the user fixes it
    form.querySelectorAll('input, select, textarea').forEach((el) => {
      el.addEventListener('input', () => {
        const id = el.id.replace('cf-', '');
        const key = id === 'type' ? 'type' : id;
        if (['name', 'email', 'type', 'message'].includes(key)) setError(key, '');
      });
    });
  }
</script>
