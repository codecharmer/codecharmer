---
interface QA { q: string; a: string }
interface Props {
  title?: string;
  items: QA[];
}
const { title = 'Common questions', items } = Astro.props;
---

<section class="section faq">
  <div class="container faq__inner">
    <h2 class="faq__title reveal">{title}</h2>
    <div class="faq__list reveal">
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span>{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq__inner { display: grid; gap: 1.5rem 4rem; }
  .faq__title { max-width: 20ch; }

  .faq__item { border-top: 1px solid var(--border); }
  .faq__item:last-child { border-bottom: 1px solid var(--border); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.35rem 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--ink);
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--brand-ink); }

  /* plus / minus icon */
  .faq__icon { position: relative; flex: none; width: 1.1rem; height: 1.1rem; }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--brand-ink);
    border-radius: 2px;
    transition: transform var(--dur) var(--ease-out-expo), opacity var(--dur) var(--ease-out-quart);
  }
  .faq__icon::before { width: 1.1rem; height: 2px; }
  .faq__icon::after { width: 2px; height: 1.1rem; }
  .faq__item[open] .faq__icon::after { transform: rotate(90deg); opacity: 0; }

  .faq__a { overflow: hidden; padding-bottom: 1.35rem; max-width: 60ch; }
  .faq__a p { color: var(--ink-muted); line-height: 1.6; }
  .faq__item[open] .faq__a { animation: faq-open var(--dur) var(--ease-out-quart); }
  @keyframes faq-open { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }

  @media (min-width: 48rem) {
    .faq__inner { grid-template-columns: 0.7fr 1.3fr; align-items: start; }
  }
</style>
