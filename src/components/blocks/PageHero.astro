---
import Button from '@components/ui/Button.astro';

interface Cta { label: string; href: string; icon?: 'arrow' }
interface Props {
  tone?: 'light' | 'ink';
  eyebrow?: string;
  title: string;
  intro?: string;
  primary?: Cta;
  secondary?: Cta;
  note?: string;
}
const { tone = 'light', eyebrow, title, intro, primary, secondary, note } = Astro.props;
---

<section class:list={['page-hero', tone === 'ink' && 'band-ink', `page-hero--${tone}`]}>
  {tone === 'ink' && <div class="page-hero__ambient" aria-hidden="true"></div>}
  <div class="container page-hero__inner">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-hero__title">{title}</h1>
    {intro && <p class="page-hero__intro lead">{intro}</p>}
    {(primary || secondary) && (
      <div class="page-hero__actions">
        {primary && <Button href={primary.href} variant="primary" size="lg">{primary.label}</Button>}
        {secondary && (
          <Button href={secondary.href} variant="secondary" size="lg" icon={secondary.icon}>{secondary.label}</Button>
        )}
      </div>
    )}
    {note && <p class="page-hero__note">{note}</p>}
  </div>
</section>

<style>
  .page-hero { position: relative; overflow: clip; padding-block: clamp(4rem, 2.5rem + 9vw, 8rem) clamp(3rem, 2rem + 5vw, 5rem); }
  .page-hero--light { border-bottom: 1px solid var(--border); }
  .page-hero__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(52% 60% at 82% 20%, oklch(0.79 0.12 202 / 0.16), transparent 70%);
    pointer-events: none;
  }
  .page-hero__inner { position: relative; max-width: 48rem; }
  .page-hero__title {
    margin-top: 1rem;
    font-size: var(--t-display);
    line-height: 1.03;
    letter-spacing: -0.03em;
    text-wrap: balance;
    font-variation-settings: 'opsz' 44;
  }
  .page-hero__intro { margin-top: 1.35rem; max-width: 40rem; }
  .page-hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .page-hero__note {
    margin-top: 1.35rem;
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--ink-muted);
  }
</style>
