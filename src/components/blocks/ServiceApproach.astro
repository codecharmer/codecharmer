---
interface Step { title: string; body: string; weight?: number }
interface Props {
  title?: string;
  intro?: string;
  steps: Step[];
}
const { title = 'How we approach it', intro, steps } = Astro.props;

// Same rail geometry as the process blocks. These steps carry no weighting
// claim in the copy, so absent a weight they divide the rail evenly.
const total = steps.reduce((sum, s) => sum + (s.weight ?? 1), 0);
let cursor = 0;
const marks = steps.map((s) => {
  const from = cursor / total;
  cursor += s.weight ?? 1;
  return { ...s, w: s.weight ?? 1, from: +from.toFixed(4), to: +(cursor / total).toFixed(4) };
});
---

<section class="section approach band-ink">
  <div class="approach__ambient" aria-hidden="true"></div>
  <div class="container approach__inner">
    <header class="approach__head reveal">
      <p class="eyebrow">Approach</p>
      <h2 class="approach__title">{title}</h2>
      {intro && <p class="lead approach__intro">{intro}</p>}
    </header>

    <div class="approach__rail rail reveal" data-scrub="band">
      <div class="approach__ruler rail__ruler" aria-hidden="true"></div>

      <div class="approach__track rail__track" aria-hidden="true">
        {marks.map((s) => (
          <div class="rail__segment" style={`--w:${s.w}`} data-from={s.from} data-to={s.to}>
            <i class="rail__run"></i>
            <span class="rail__node rail__node--astride" data-from={s.from} data-to={s.to} />
          </div>
        ))}
        <span class="rail__playhead"></span>
      </div>

      <ol role="list" class="approach__steps">
        {marks.map((s, i) => (
          <li class="approach__step" style={`--w:${s.w}`} data-from={s.from} data-to={s.to}>
            <span class="approach__meta">
              <span class="rail__coord">{String(i + 1).padStart(2, '0')}</span>
              <span class="rail__status" aria-hidden="true"></span>
            </span>
            <h3 class="approach__step-title">{s.title}</h3>
            <p class="approach__step-body">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .approach { position: relative; overflow: clip; }
  .approach__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(45% 55% at 12% 15%, oklch(0.79 0.12 202 / 0.12), transparent 70%);
    pointer-events: none;
  }
  .approach__inner { position: relative; }
  .approach__head { max-width: 40rem; }
  .approach__title { margin-top: 0.9rem; }
  .approach__intro { margin-top: 1rem; }

  .approach__rail {
    --rail-track-w: 6px;
    --rail-node: 12px;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .approach__ruler { margin-bottom: 4px; }

  .approach__steps { display: flex; }
  .approach__step {
    flex: var(--w, 1) 1 0;
    padding-top: 1.1rem;
    padding-inline-end: clamp(1rem, 3vw, 2.5rem);
    min-width: 0;
  }
  .approach__meta {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
  }
  .approach__step-title {
    margin-top: 0.35rem;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--on-ink);
  }
  .approach__step-body { margin-top: 0.5rem; color: var(--on-ink-mut); line-height: 1.55; max-width: 46ch; }

  /* Sequential lighting as the build reaches each step. Default: all lit. */
  .rail[data-rail-live] .approach__step {
    transition: opacity var(--dur-slow) var(--ease-out-quart);
  }
  .rail[data-rail-live] .approach__step[data-state='queued'] { opacity: 0.45; }
  .rail[data-rail-live] .approach__step[data-state='active'] .approach__step-title {
    color: var(--brand-glow);
  }
  /* On the ink band the faint queued-status color needs the muted on-ink. */
  .rail[data-rail-live] .approach__step[data-state='queued'] .rail__status {
    color: var(--on-ink-mut);
  }

  /* Vertical below the 3-up breakpoint — the spine runs down the left. */
  @media (max-width: 52rem) {
    .approach__rail {
      display: grid;
      grid-template-columns: auto auto 1fr;
      gap: 0 1rem;
    }
    .approach__ruler {
      width: var(--rail-tick-len);
      height: auto;
      margin-bottom: 0;
      background-image: repeating-linear-gradient(
        to bottom,
        var(--rail-tick) 0 1px,
        transparent 1px var(--rail-tick-gap)
      );
      background-repeat: repeat-y;
      background-size: var(--rail-tick-len) var(--rail-tick-gap);
      background-position: 100% 0;
      mask-image: linear-gradient(to bottom, #000 90%, transparent);
    }
    .approach__track {
      flex-direction: column;
      width: var(--rail-track-w);
      height: auto;
      container-type: size;
    }
    .approach__track::after {
      transform-origin: center top;
      transform: scaleY(var(--rail-progress));
      background: linear-gradient(to bottom, var(--rail-fill) 0 88%, var(--brand-glow) 100%);
    }
    .approach__track .rail__segment + .rail__segment::before {
      inset-block: auto; inset-inline: -1px; top: 0; left: auto; width: auto; height: 2px;
    }
    .approach__track .rail__segment::after {
      bottom: auto; left: auto; right: calc(100% + 4px); top: 0;
      width: var(--rail-tick-len-major); height: 1px;
    }
    .approach__track .rail__node--astride { left: 50%; top: 0; }
    .approach__track .rail__playhead {
      inset-block: auto; inset-inline: -4px; top: 0; left: auto;
      width: auto; height: 2px;
      translate: 0 calc(var(--rail-progress) * var(--rail-span, 100cqh));
    }
    .approach__track .rail__playhead::before,
    .approach__track .rail__playhead::after { top: -2px; left: auto; width: 2px; height: 6px; }
    .approach__track .rail__playhead::before { left: 0; }
    .approach__track .rail__playhead::after { right: 0; }

    .approach__steps { flex-direction: column; }
    .approach__step {
      padding-top: 0;
      padding-inline-end: 0;
      padding-bottom: 2rem;
    }
    .approach__step:last-child { padding-bottom: 0; }
  }
</style>
