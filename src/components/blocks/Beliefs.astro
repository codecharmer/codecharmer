---
import Icon from '@components/ui/Icon.astro';
import { beliefs } from '@data/site';
---

<section class="section beliefs band-ink">
  <div class="beliefs__ambient" aria-hidden="true"></div>
  <div class="container beliefs__inner">
    <div class="beliefs__head reveal">
      <h2 class="beliefs__title">We have opinions about this&nbsp;work.</h2>
      <p class="lead beliefs__intro">
        They’re why clients bring us the projects that matter, and why the results tend to outlast us.
      </p>
    </div>

    <ul role="list" class="beliefs__grid">
      {
        beliefs.map((b, i) => (
          <li class="belief reveal" style={`--reveal-delay:${i * 80}ms`}>
            <span class="belief__mark" aria-hidden="true"><Icon name="spark" size={18} /></span>
            <h3 class="belief__title">{b.title}</h3>
            <p class="belief__body">{b.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .beliefs { position: relative; overflow: clip; }
  .beliefs__ambient {
    position: absolute;
    inset: 0;
    background: radial-gradient(45% 55% at 85% 12%, oklch(0.79 0.12 202 / 0.12), transparent 70%);
    pointer-events: none;
  }
  .beliefs__inner { position: relative; }
  .beliefs__head { max-width: 40rem; }
  .beliefs__intro { margin-top: 1rem; }

  .beliefs__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 4vw, 3rem) clamp(2rem, 5vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 3.75rem);
  }
  @media (min-width: 40rem) { .beliefs__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .beliefs__grid { grid-template-columns: repeat(4, 1fr); } }
  .belief { max-width: 34ch; }
  .belief__mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    background: oklch(0.83 0.13 200 / 0.12);
    color: var(--brand-glow);
    margin-bottom: 1rem;
  }
  .belief__title {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--on-ink);
    margin-bottom: 0.5rem;
  }
  .belief__body { color: var(--on-ink-mut); line-height: 1.55; }
</style>
