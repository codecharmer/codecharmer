---
import Button from '@components/ui/Button.astro';
import SystemDiagram from '@components/graphics/SystemDiagram.astro';
import { nav } from '@data/site';
---

<section class="hero band-ink">
  <div class="hero__ambient" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="hero__kicker eyebrow">Digital engineering studio</p>

      <h1 class="hero__title">
        We build digital systems that
        <span class="charm">
          earn their keep
          <svg class="charm__line" viewBox="0 0 240 14" preserveAspectRatio="none" aria-hidden="true">
            <path d="M3 8c40-6 92-7 138-5 30 1 62 3 96 6" pathLength="1" />
          </svg>
        </span>
      </h1>

      <p class="hero__sub">
        AI-first architecture, serious WordPress engineering, and custom software —
        built to generate revenue, automate the busywork, and stay yours to run.
      </p>

      <div class="hero__actions">
        <Button href={nav.cta.href} variant="primary" size="lg">{nav.cta.label}</Button>
        <Button href="/work" variant="secondary" size="lg" icon="arrow">See our work</Button>
      </div>

      <p class="hero__trust">No lock-in. You own everything we build.</p>
    </div>

    <div class="hero__visual" aria-hidden="false">
      <SystemDiagram />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: clip;
    padding-block: clamp(3.5rem, 2rem + 9vw, 7.5rem) clamp(4rem, 2.5rem + 9vw, 8rem);
  }
  .hero__ambient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 55% at 78% 30%, oklch(0.79 0.12 202 / 0.18), transparent 70%),
      radial-gradient(50% 60% at 8% 90%, oklch(0.6 0.1 250 / 0.14), transparent 70%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__kicker { margin-bottom: 1.25rem; }

  .hero__title {
    font-size: var(--t-display);
    font-weight: 750;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
    font-variation-settings: 'opsz' 48;
  }

  /* Charm underline */
  .charm { position: relative; white-space: nowrap; color: var(--brand-glow); }
  .charm__line {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.14em;
    width: 100%;
    height: 0.42em;
    overflow: visible;
  }
  .charm__line path {
    fill: none;
    stroke: var(--brand);
    stroke-width: 3;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px oklch(0.79 0.12 202 / 0.5));
  }

  .hero__sub {
    max-width: 34rem;
    margin-top: 1.5rem;
    font-size: var(--t-body-lg);
    line-height: 1.55;
    color: var(--on-ink-mut);
    text-wrap: pretty;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 2rem; }
  .hero__trust {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--t-small);
    color: var(--on-ink-mut);
  }

  .hero__visual {
    justify-self: center;
    width: 100%;
    max-width: 34rem;
  }

  @media (min-width: 62rem) {
    /* minmax(0,…) so the display type's min-content can't quietly annex the
       diagram's column — the system graphic is half the argument here. */
    .hero__inner { grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr); }
    .hero__visual { max-width: none; }
  }

  /* Load orchestration — only when motion is welcome; default state is visible */
  @media (prefers-reduced-motion: no-preference) {
    .hero__kicker,
    .hero__title,
    .hero__sub,
    .hero__actions,
    .hero__trust { animation: hero-rise 0.72s var(--ease-out-expo) both; }
    .hero__kicker { animation-delay: 0.05s; }
    .hero__title { animation-delay: 0.14s; }
    .hero__sub { animation-delay: 0.28s; }
    .hero__actions { animation-delay: 0.4s; }
    .hero__trust { animation-delay: 0.5s; }
    .hero__visual { animation: hero-fade 1s var(--ease-out-quart) 0.3s both; }

    .charm__line path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: charm-draw 0.7s var(--ease-out-quart) 0.75s forwards;
    }

    @keyframes hero-rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
    @keyframes hero-fade { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: none; } }
    @keyframes charm-draw { to { stroke-dashoffset: 0; } }
  }
</style>
