---
import Icon from '@components/ui/Icon.astro';
import { pillars } from '@data/site';
---

<section class="section pillars">
  <div class="container">
    <header class="pillars__head reveal">
      <p class="eyebrow">What we build</p>
      <h2 class="pillars__title">Four disciplines, engineered to work as one system.</h2>
      <p class="lead pillars__intro">
        Most projects touch more than one. That’s the point — the value shows up where they connect.
      </p>
    </header>

    <ul role="list" class="pillars__list">
      {
        pillars.map((p, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 70}ms`}>
            <a class="pillar" href={p.href}>
              <span class="pillar__icon"><Icon name={p.icon} size={26} /></span>
              <span class="pillar__body">
                <span class="pillar__name">{p.name}</span>
                <span class="pillar__desc">{p.descriptor}</span>
              </span>
              <span class="pillar__go" aria-hidden="true"><Icon name="arrow" size={20} /></span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pillars__head { max-width: 42rem; }
  .pillars__title { margin-top: 0.9rem; }
  .pillars__intro { margin-top: 1rem; }

  .pillars__list { margin-top: clamp(2rem, 4vw, 3.25rem); }
  .pillars__list > li { border-top: 1px solid var(--border); }
  .pillars__list > li:last-child { border-bottom: 1px solid var(--border); }

  .pillar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    padding: clamp(1.25rem, 3vw, 1.9rem) 0.25rem;
    transition: padding-inline var(--dur) var(--ease-out-expo);
  }
  .pillar:hover { padding-inline: 1.1rem 0.25rem; }

  .pillar__icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--brand) 12%, var(--surface));
    color: var(--brand-ink);
    border: 1px solid var(--border);
    transition: background-color var(--dur) var(--ease-out-quart), color var(--dur) var(--ease-out-quart);
  }
  .pillar:hover .pillar__icon { background: var(--brand); color: var(--on-brand); border-color: transparent; }

  .pillar__body { display: flex; flex-direction: column; gap: 0.3rem; }
  .pillar__name {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 0.9rem + 1vw, 1.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .pillar__desc { color: var(--ink-muted); max-width: 44ch; }

  .pillar__go {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-pill);
    color: var(--ink-muted);
    transition: transform var(--dur) var(--ease-out-expo), color var(--dur) var(--ease-out-quart), background-color var(--dur) var(--ease-out-quart);
  }
  .pillar:hover .pillar__go { color: var(--brand-ink); transform: translateX(4px); }

  @media (max-width: 34rem) {
    .pillar { grid-template-columns: auto 1fr; }
    .pillar__go { display: none; }
  }
</style>
