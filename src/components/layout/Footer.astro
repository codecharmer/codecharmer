---
import Logo from '@components/ui/Logo.astro';
import Icon from '@components/ui/Icon.astro';
import { site, pillars, nav } from '@data/site';
const year = 2026;
---

<footer class="site-footer band-ink">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo href={null} />
        <p class="footer__tagline">{site.tagline}</p>
        <a class="footer__email link" href={`mailto:${site.email}`}>{site.email}</a>
      </div>

      <nav class="footer__cols" aria-label="Footer">
        <div class="footer__col">
          <h2 class="footer__heading">Services</h2>
          <ul role="list">
            {pillars.map((p) => (
              <li><a href={p.href}>{p.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="footer__col">
          <h2 class="footer__heading">Company</h2>
          <ul role="list">
            <li><a href="/work">Work</a></li>
            <li><a href="/process">Process</a></li>
            <li><a href="/about">About</a></li>
          </ul>
        </div>
        <div class="footer__col">
          <h2 class="footer__heading">Get started</h2>
          <ul role="list">
            <li><a href={nav.cta.href}>{nav.cta.label}</a></li>
            <li><a href={`mailto:${site.email}`}>Email us</a></li>
          </ul>
          <a class="footer__cta" href={nav.cta.href}>
            Start a project <Icon name="arrow" size={16} />
          </a>
        </div>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>&copy; {year} {site.name}. Digital systems that create business value.</p>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer { padding-block: clamp(3.5rem, 2rem + 7vw, 6rem) 2.5rem; }
  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem 3rem;
  }
  .footer__brand { max-width: 22rem; }
  .footer__tagline {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--on-ink);
    text-wrap: balance;
  }
  .footer__email { display: inline-block; margin-top: 1rem; color: var(--brand-glow); }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .footer__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-ink-mut);
    margin-bottom: 1rem;
  }
  .footer__col ul { display: flex; flex-direction: column; gap: 0.7rem; }
  .footer__col a {
    color: var(--on-ink-mut);
    transition: color var(--dur-fast) var(--ease-out-quart);
  }
  .footer__col a:hover { color: var(--on-ink); }
  .footer__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-weight: 600;
    color: var(--brand-glow) !important;
  }
  .footer__cta:hover { gap: 0.75rem; }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--on-ink-mut);
  }
  .footer__bottom a { color: var(--on-ink-mut); }
  .footer__bottom a:hover { color: var(--on-ink); }

  @media (min-width: 48rem) {
    .footer__top { grid-template-columns: 1.1fr 1.4fr; }
  }
  @media (max-width: 34rem) {
    .footer__cols { grid-template-columns: 1fr 1fr; }
  }
</style>
