---
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import CtaBand from '@components/blocks/CtaBand.astro';
import Icon from '@components/ui/Icon.astro';
import { process } from '@data/site';

const principles = [
  { t: 'Architecture before code', b: 'The most expensive mistakes are made before the first line is written. We spend the time there.' },
  { t: 'Simplicity beats complexity', b: 'The best system is the smallest one that solves the problem. Less to build, less to break, less to maintain.' },
  { t: 'You own the result', b: 'We build so your team can run it. The goal is leverage, not a dependency on us.' },
];
---

<Base
  path="/process"
  title="Process — How the work gets done | Code Charmer"
  description="Seven stages, each one making the next cheaper: discovery, architecture, design, development, testing, launch, growth."
>
  <PageHero
    tone="ink"
    eyebrow="Process"
    title="Architecture before code."
    intro="Seven stages, each one making the next cheaper. It’s deliberately front-loaded — the thinking that happens early is what keeps the whole project on budget."
    primary={{ label: 'Start a project', href: '/contact' }}
  />

  <section class="section timeline-sec">
    <div class="container">
      <ol role="list" class="timeline">
        {process.map((s) => (
          <li class="tstage reveal">
            <div class="tstage__rail" aria-hidden="true">
              <span class="tstage__node">{String(s.n).padStart(2, '0')}</span>
            </div>
            <div class="tstage__content">
              <h2 class="tstage__name">{s.name}</h2>
              <p class="tstage__body">{s.body}</p>
              <p class="tstage__deliverable">
                <span class="tstage__deliverable-label">You get</span>
                {s.deliverable}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section principles band-ink">
    <div class="principles__ambient" aria-hidden="true"></div>
    <div class="container principles__inner">
      <h2 class="principles__title reveal">Three things that don’t change.</h2>
      <ul role="list" class="principles__grid">
        {principles.map((p, i) => (
          <li class="principle reveal" style={`--reveal-delay:${i * 80}ms`}>
            <span class="principle__mark" aria-hidden="true"><Icon name="spark" size={18} /></span>
            <h3 class="principle__t">{p.t}</h3>
            <p class="principle__b">{p.b}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand
    heading="Ready to start with discovery?"
    body="The first conversation is exactly that — understanding the problem before anyone talks solutions."
  />
</Base>

<style>
  .timeline { display: flex; flex-direction: column; }
  .tstage { display: grid; grid-template-columns: auto 1fr; gap: clamp(1.25rem, 3vw, 2.25rem); }
  .tstage__rail { display: flex; flex-direction: column; align-items: center; }
  .tstage__node {
    flex: none;
    display: grid; place-items: center;
    width: 3rem; height: 3rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--brand) 12%, var(--surface));
    border: 1.5px solid var(--brand);
    color: var(--brand-ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 500;
  }
  /* connecting line between nodes */
  .tstage:not(:last-child) .tstage__rail::after {
    content: '';
    flex: 1;
    width: 1.5px;
    margin-block: 0.5rem;
    background: linear-gradient(var(--border-strong), var(--border));
    min-height: 1.5rem;
  }
  .tstage__content { padding-bottom: clamp(2rem, 4vw, 3rem); max-width: 46rem; }
  .tstage:last-child .tstage__content { padding-bottom: 0; }
  .tstage__name { font-size: var(--t-h3); letter-spacing: -0.02em; }
  .tstage__body { margin-top: 0.75rem; color: var(--ink-muted); line-height: 1.6; }
  .tstage__deliverable {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 1.15rem;
    padding: 0.65rem 1rem;
    border-radius: var(--radius-sm);
    background: color-mix(in oklab, var(--brand) 8%, var(--surface));
    border: 1px solid var(--border);
    color: var(--ink);
    font-weight: 500;
  }
  .tstage__deliverable-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-ink);
  }

  .principles { position: relative; overflow: clip; }
  .principles__ambient {
    position: absolute; inset: 0;
    background: radial-gradient(45% 55% at 88% 15%, oklch(0.79 0.12 202 / 0.12), transparent 70%);
    pointer-events: none;
  }
  .principles__inner { position: relative; }
  .principles__title { max-width: 24ch; }
  .principles__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: clamp(1.75rem, 4vw, 3rem);
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .principle__mark {
    display: grid; place-items: center;
    width: 2.5rem; height: 2.5rem; margin-bottom: 1rem;
    border-radius: var(--radius-sm);
    background: oklch(0.83 0.13 200 / 0.12);
    color: var(--brand-glow);
  }
  .principle__t { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.015em; color: var(--on-ink); }
  .principle__b { margin-top: 0.5rem; color: var(--on-ink-mut); line-height: 1.55; }

  @media (min-width: 64rem) {
    .principles__grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
