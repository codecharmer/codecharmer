---
import Base from '@layouts/Base.astro';
import PageHero from '@components/blocks/PageHero.astro';
import FeatureList from '@components/blocks/FeatureList.astro';
import ServiceApproach from '@components/blocks/ServiceApproach.astro';
import Faq from '@components/blocks/Faq.astro';
import CtaBand from '@components/blocks/CtaBand.astro';
import Button from '@components/ui/Button.astro';
import { pillars } from '@data/site';

export function getStaticPaths() {
  return pillars.map((p) => ({
    params: { slug: p.slug },
    props: { pillar: p },
  }));
}

const { pillar } = Astro.props;
---

<Base
  path={pillar.href}
  title={`${pillar.name} — Code Charmer`}
  description={pillar.thesis}
>
  <PageHero
    tone="ink"
    eyebrow={pillar.name}
    title={pillar.problem}
    intro={pillar.thesis}
    primary={{ label: 'Book a consultation', href: '/contact' }}
    secondary={{ label: 'See our work', href: '/work', icon: 'arrow' }}
  />

  <FeatureList
    eyebrow="Capabilities"
    title={`What ${pillar.name} includes.`}
    items={pillar.included}
  />

  <ServiceApproach steps={pillar.approach} />

  <section class="section proof">
    <div class="container proof__inner reveal">
      <div>
        <p class="eyebrow">Proof</p>
        <h2 class="proof__title">Every claim here has shipped.</h2>
        <p class="lead proof__intro">See the projects we’ve put into the world — built to work as well as they look.</p>
      </div>
      <Button href="/work" variant="secondary" size="lg" icon="arrow">View our work</Button>
    </div>
  </section>

  <Faq items={pillar.faq} />

  <CtaBand
    heading={`Let’s talk about ${pillar.name}.`}
    body="Tell us what you're trying to do. A short conversation is usually enough to know whether we're the right team."
  />
</Base>

<style>
  .proof__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2.5rem;
  }
  .proof__inner > div { max-width: 44rem; }
  .proof__title { margin-top: 0.9rem; }
  .proof__intro { margin-top: 0.85rem; }
</style>
