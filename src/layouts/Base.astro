---
// Self-hosted variable fonts (Fontsource). Bricolage uses the full axis set
// (opsz + wght); body and mono only need weight.
import '@fontsource-variable/bricolage-grotesque/index.css';
import '@fontsource-variable/hanken-grotesk/wght.css';
import '@fontsource-variable/geist-mono/wght.css';
import '@styles/global.css';
import '@styles/rail.css';

import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import { site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
  /** Path for canonical/OG, e.g. "/". */
  path?: string;
}
const {
  title = `${site.name} — ${site.tagline}`,
  description = site.positioning,
  path = Astro.url.pathname,
} = Astro.props;

const canonical = new URL(path, site.url).href;
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%230f1720'/%3E%3Cpath d='M11 20 21 9' stroke='%23e8fbfe' stroke-width='2.4' stroke-linecap='round'/%3E%3Cpath d='M22 6c.3 2 .8 3 2.5 3.6C22.8 10.2 22.3 11.2 22 13c-.3-1.8-.8-2.8-2.5-3.4C21.2 9 21.7 8 22 6Z' fill='%2340d6e8'/%3E%3C/svg%3E";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={favicon} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f1720" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Arm scroll reveals before paint (no flash), but only when they can
         actually be delivered. IntersectionObserver callbacks ride rendering
         opportunities, so a tab that starts hidden may never get one — arming
         the gate there would hide the whole page indefinitely. Motion off or
         document hidden: never gate, content just renders. -->
    <script is:inline>
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        document.visibilityState !== 'hidden'
      ) {
        document.documentElement.classList.add('reveals-ready');
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import { initRails } from '@scripts/rail';
      initRails();
    </script>

    <script>
      // Reveal-on-scroll: enhance an already-visible default.
      //
      // Nothing here may leave content hidden. IntersectionObserver only
      // delivers callbacks on rendering opportunities, so a hidden, throttled,
      // or instantly-jumped-past element can go without one indefinitely —
      // and an element gated at opacity 0 that never gets its callback is a
      // permanently invisible section. Every path below ends in `is-in`.
      const revealables = document.querySelectorAll<HTMLElement>('.reveal');
      const revealAll = () => revealables.forEach((el) => el.classList.add('is-in'));

      if (revealables.length && document.documentElement.classList.contains('reveals-ready')) {
        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-in');
                obs.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
        );
        revealables.forEach((el) => io.observe(el));

        // Failsafe: whatever the observer has not reached by now becomes
        // visible anyway. Bounds worst-case invisibility to one beat.
        const failsafe = window.setTimeout(revealAll, 1600);

        // Leaving the tab stops rendering, and therefore stops callbacks.
        // Reveal everything rather than let a backgrounded page freeze
        // half-hidden; also covers bfcache restores.
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') {
            window.clearTimeout(failsafe);
            revealAll();
          }
        });
        window.addEventListener('pageshow', revealAll);
      } else {
        revealAll();
      }
    </script>
  </body>
</html>
