{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "codecharmer/changelog",
	"title": "Changelog",
	"category": "codecharmer",
	"icon": "backup",
	"description": "Release history: versioned entries with a summary and notable changes, in the measurement register.",
	"textdomain": "codecharmer-core",
	"attributes": {
		"eyebrow": { "type": "string", "default": "Changelog" },
		"heading": { "type": "string", "default": "" },
		"intro": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
