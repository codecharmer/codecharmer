{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "codecharmer/flagship",
	"title": "Flagship Product",
	"category": "codecharmer",
	"icon": "star-filled",
	"description": "Deep-ink flagship band: product name, tagline, highlights, stack line, CTAs and the engineered board artwork.",
	"textdomain": "codecharmer-core",
	"attributes": {
		"eyebrow": { "type": "string", "default": "Flagship product" },
		"name": { "type": "string", "default": "" },
		"tagline": { "type": "string", "default": "" },
		"description": { "type": "string", "default": "" },
		"stackLine": { "type": "string", "default": "" },
		"primaryLabel": { "type": "string", "default": "" },
		"primaryUrl": { "type": "string", "default": "" },
		"secondaryLabel": { "type": "string", "default": "" },
		"secondaryUrl": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
