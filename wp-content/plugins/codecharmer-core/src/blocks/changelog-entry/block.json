{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "codecharmer/changelog-entry",
	"title": "Changelog Entry",
	"category": "codecharmer",
	"icon": "flag",
	"description": "One release: version, date, title, summary and notable changes.",
	"textdomain": "codecharmer-core",
	"parent": [ "codecharmer/changelog" ],
	"attributes": {
		"version": { "type": "string", "default": "" },
		"date": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"summary": { "type": "string", "default": "" },
		"items": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js"
}
