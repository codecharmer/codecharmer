{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "codecharmer/stat",
	"title": "Stat",
	"category": "codecharmer",
	"icon": "chart-bar",
	"description": "One stat: value, label, and an optional context note.",
	"textdomain": "codecharmer-core",
	"parent": [
		"codecharmer/stats"
	],
	"attributes": {
		"value": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"note": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js"
}
